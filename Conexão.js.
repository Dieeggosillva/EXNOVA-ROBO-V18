
const API_URL = "https://biquote.io/api/EURUSD/ohlc?interval=1m&limit=300";

async function buscarVelasM1() {
  try {
    const resposta = await fetch(API_URL);

    if (!resposta.ok) {
      throw new Error(`Erro HTTP: ${resposta.status}`);
    }

    const dados = await resposta.json();

    const velasFechadas = dados.bars
      .filter(vela => vela.isOpen === false)
      .map(vela => ({
        horario: vela.openTime,
        open: Number(vela.open),
        high: Number(vela.high),
        low: Number(vela.low),
        close: Number(vela.close),
        volume: Number(vela.volume),
        tickVolume: Number(vela.tickVolume)
      }))
      .filter(vela =>
        Object.values(vela).every(valor =>
          typeof valor === "number" ? Number.isFinite(valor) : Boolean(valor)
        )
      );

    console.log("Ativo:", dados.symbol);
    console.log("Período:", dados.interval);
    console.log("Velas fechadas:", velasFechadas.length);
    console.log("Última vela:", velasFechadas.at(-1));

    return velasFechadas;

  } catch (erro) {
    console.error("Falha ao buscar velas:", erro);
    return [];
  }
}

buscarVelasM1();
setInterval(buscarVelasM1, 10000);
